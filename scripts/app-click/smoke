#!/usr/bin/env python3
"""harness_smoke (ticket 171): launch a copy of the installed app on a temp home, open Settings, capture, quit.
Exit 0 with the capture path printed; 3 when the window hung (no AX answer for 5 s); 1 on any other failure.
Capture lands in .scratch/app-click/shots/smoke-settings.png."""
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
import harness  # noqa: E402

try:
    with harness.App() as app:
        app.press(harness.SETTINGS)
        if not app.find(harness.APPEARANCE):
            raise RuntimeError("Settings did not open (no Appearance page in the nav)")
        shot = app.capture("smoke-settings")
        if not app.quit():
            raise RuntimeError("Quit Nunchiro did not close the window within 10 s")
    print(f"PASS harness_smoke {shot}")
except harness.Hang as e:
    print(f"FAIL hang: {e}")
    sys.exit(harness.HANG)
except Exception as e:  # noqa: BLE001  the smoke reports every other failure as one line
    print(f"FAIL {type(e).__name__}: {e}")
    sys.exit(1)
