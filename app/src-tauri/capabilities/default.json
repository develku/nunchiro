{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The window may close itself (detach), drag by its title bar and zoom (maximise) on a double click of it (the drag region's own two commands), open http(s) links in the user's browser open the folder picker (dialog open only) and open the two System Settings privacy panes Permission needed names and the Local Network pane Settings > Permissions names, and the Camera and Microphone panes Settings > In-app browser names; all data goes through the loopback API.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "opener:allow-reveal-item-in-dir",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "x-apple.systempreferences:com.apple.preference.security[?]Privacy_FilesAndFolders"
        },
        {
          "url": "x-apple.systempreferences:com.apple.preference.security[?]Privacy_AllFiles"
        },
        {
          "url": "x-apple.systempreferences:com.apple.settings.PrivacySecurity.extension[?]Privacy_LocalNetwork"
        },
        {
          "url": "x-apple.systempreferences:com.apple.preference.security[?]Privacy_Camera"
        },
        {
          "url": "x-apple.systempreferences:com.apple.preference.security[?]Privacy_Microphone"
        }
      ]
    }
  ]
}
