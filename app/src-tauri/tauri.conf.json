{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nunchiro",
  "version": "0.1.0",
  "identifier": "dev.nunchiro.app",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-src nunchiro-artifact: http://nunchiro-artifact.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../licenses/THIRD_PARTY_LICENSES_RUST.md": "THIRD_PARTY_LICENSES_RUST.md",
      "../../licenses/THIRD_PARTY_LICENSES_NPM.md": "THIRD_PARTY_LICENSES_NPM.md"
    }
  }
}
