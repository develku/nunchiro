#!/usr/bin/env python3
"""Claude fixture for the permission-mode chip: draws Claude 2.1.310's footer, cycles it on Shift+Tab (ESC [ Z),
logs every stdin read as hex. A `D` byte, or a file named `dialog` in its folder, draws a permission dialog in
place of the box; a file named `plain` draws a bare `❯` row with no ruled box (a screen Claude's composer
reader does not recognise). No model calls."""
import os, select, sys, tty

if '--version' in sys.argv:
    print('2.1.310 (Claude Code)')
    raise SystemExit
home = os.environ['NUNCHIRO_HOME']
log = open(os.path.join(home, 'stdin-' + os.environ['NUNCHIRO_SESSION'] + '.log'), 'a')
FOOTERS = ['  ⏸ manual mode on (shift+tab to cycle)', '  ⏵⏵ accept edits on (shift+tab to cycle)', '  ⏸ plan mode on (shift+tab to cycle)']
mode, dialog, plain = 0, False, False


def draw():
    rule = '─' * os.get_terminal_size(1).columns
    out = ['\x1b[2J\x1b[H']
    if plain:
        out.append('Something new\r\n❯ \r\n')
    elif dialog:
        out.append('Bash command\r\n  ls\r\n Do you want to proceed?\r\n ❯ 1. Yes\r\n   2. No\r\n\r\n Esc to cancel\r\n')
    else:
        out.append(rule + '\r\n❯ \r\n' + rule + '\r\n' + FOOTERS[mode] + '\r\n')
    sys.stdout.write(''.join(out))
    sys.stdout.flush()


tty.setraw(0)
draw()
while True:
    if not select.select([0], [], [], 0.1)[0]:
        if not dialog and os.path.exists('dialog'):
            dialog = True
            draw()
        if not plain and os.path.exists('plain'):
            plain = True
            draw()
        continue
    data = os.read(0, 1024)
    if not data:
        break
    log.write('READ ' + data.hex() + '\n')
    log.flush()
    if data == b'\x1b[Z':
        mode = (mode + 1) % len(FOOTERS)
    elif data == b'D':
        dialog = True
    draw()
