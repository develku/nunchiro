#!/usr/bin/env python3
"""Codex fixture captures actual launch policy and reports its resume id via the hook."""
import json, os, re, subprocess, sys
if '--version' in sys.argv:
    print('codex-cli 99.0.0')
    raise SystemExit
args = sys.argv[1:]
if args[:1] == ['app-server']:
    # Ticket 1150: before a Codex start the core asks that Codex which hooks it would run, and starts it only when
    # Nunchiro's outward hook is listed, on and trusted. This one says so (the answers of
    # nunchiro-core/tests/fixtures/codex-app-server), unless the test's `codex-app-server.json` says otherwise: a
    # result per method (a method left out is not answered), and `behave` for a Codex that cannot be asked: "exit",
    # "garbage", or seconds to wait before it answers.
    results = {'initialize': {}, 'hooks/list': {'data': [{'hooks': [{
        'key': '/<session-flags>/config.toml:pre_tool_use:0:0', 'enabled': True, 'trustStatus': 'trusted'}]}]}}
    answers = os.path.join(os.environ['NUNCHIRO_HOME'], 'codex-app-server.json')
    if os.path.exists(answers):
        results = json.load(open(answers))
    behave = results.pop('behave', None)
    if behave == 'exit':
        raise SystemExit
    if behave == 'garbage':
        print('Welcome to Codex', flush=True)
    elif behave:
        import time
        time.sleep(behave)
    for line in sys.stdin:
        request = json.loads(line)
        if 'id' in request and request['method'] in results:
            print(json.dumps({'id': request['id'], 'result': results[request['method']]}), flush=True)
    raise SystemExit
print('LAUNCH:' + json.dumps(args), flush=True)
for arg in args:
    if arg.startswith('hooks.SessionStart='):
        command = json.loads(re.search(r'command=("(?:[^"\\]|\\.)*")', arg).group(1))
        subprocess.run(command, shell=True, input=json.dumps({'session_id': 'FAKE-CODEX-123'}).encode(), check=True)
# Keep the actual rollout fd open, like Codex's recorder, to test provenance discovery.
rollout = open(os.path.join(os.environ['NUNCHIRO_HOME'], 'rollout-' + os.environ['NUNCHIRO_SESSION'] + '.jsonl'), 'w+')
rollout.write(json.dumps({'type':'session_meta', 'payload':{'id':'FAKE-CODEX-123', 'cwd':os.getcwd(), 'source':'cli'}}) + '\n')
rollout.flush()
print('READY', flush=True)
for line in sys.stdin:
    print('ACK:' + line.strip(), flush=True)
