#!/usr/bin/env python3
"""Interactive agent fixture: launch flags and hooks, no credentials or model calls."""
import json, os, subprocess, sys, time, pathlib
if '--version' in sys.argv:
    if os.environ.get('FIXTURE_GATE') == 'version':
        home = pathlib.Path(os.environ['NUNCHIRO_HOME'])
        (home / 'probe-started').touch()
        deadline = time.monotonic() + 5
        while not (home / 'probe-release').exists():
            if not home.exists() or time.monotonic() >= deadline: raise SystemExit(1)
            time.sleep(.01)
    print('99.0.0 (unknown fixture)')
    raise SystemExit
args = sys.argv[1:]
print('LAUNCH:' + json.dumps(args), flush=True)
print('CWD:' + os.getcwd(), flush=True)
settings = json.load(open(args[args.index('--settings') + 1])) if '--settings' in args else {}
if 'hooks' in settings:  # v1b-07: with hook injection off the settings file carries only the artifact rule
    command = settings['hooks']['SessionStart'][0]['hooks'][0]['command']
    flag = '--resume' if '--resume' in args else '--session-id'
    subprocess.run(command, shell=True, input=json.dumps({'session_id': args[args.index(flag)+1]}).encode(), check=True)
print('READY', flush=True)
if '--fixture-exit' in args: os._exit(0)
for line in sys.stdin:
    print('ACK:' + line.strip(), flush=True)
