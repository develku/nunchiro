#!/usr/bin/env python3
"""Leave a same-group helper after its leader exits; ignore terminal hangup."""
import os, signal, time
read_end, write_end = os.pipe()
pid = os.fork()
if pid == 0:
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    print('CHILD:' + str(os.getpid()), flush=True)
    os.write(write_end, b'1')
    time.sleep(30)
    os._exit(0)
os.read(read_end, 1)
os._exit(0)
