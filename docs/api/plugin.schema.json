{
  "$defs": {
    "Command": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "description": "argv, run from the plugin folder; never a shell string.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "network": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "read": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "show": {
          "$ref": "#/$defs/Show",
          "default": "note"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "command"
      ],
      "type": "object"
    },
    "Panel": {
      "additionalProperties": false,
      "description": "A widget manifest inside the plugin (the fields of `widget.toml`), named so its plugin can hold several.",
      "properties": {
        "command": {
          "description": "A script panel's argv, run from the plugin folder.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "entry": {
          "description": "A web panel's HTML file in the plugin folder.",
          "type": [
            "string",
            "null"
          ]
        },
        "interval_secs": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "kind": {
          "description": "`script` or `web`.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "network": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "read": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "type": "object"
    },
    "Setting": {
      "additionalProperties": false,
      "properties": {
        "choices": {
          "description": "The values of a `choice` setting.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "default": true,
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SettingKind"
        }
      },
      "required": [
        "key",
        "label",
        "type"
      ],
      "type": "object"
    },
    "SettingKind": {
      "oneOf": [
        {
          "enum": [
            "text",
            "number",
            "bool",
            "choice"
          ],
          "type": "string"
        },
        {
          "const": "time",
          "description": "`HH:MM`, 24-hour.",
          "type": "string"
        }
      ]
    },
    "Show": {
      "description": "Where a command's output goes: a note, a panel, or the focused agent's composer as a draft (never sent by itself).",
      "enum": [
        "note",
        "panel",
        "send"
      ],
      "type": "string"
    }
  },
  "$id": "https://raw.githubusercontent.com/develku/nunchiro/main/docs/api/plugin.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`plugin.toml`. Unknown keys refuse the whole file.",
  "properties": {
    "about": {
      "default": "",
      "type": "string"
    },
    "author": {
      "type": [
        "string",
        "null"
      ]
    },
    "command": {
      "description": "Rows in the command palette.",
      "items": {
        "$ref": "#/$defs/Command"
      },
      "type": "array"
    },
    "id": {
      "description": "The folder's name: a-z, 0-9, - and _ (up to 64).",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "nunchiro": {
      "description": "The Nunchiro versions the plugin is made for, as written; shown, not enforced yet.",
      "type": [
        "string",
        "null"
      ]
    },
    "panel": {
      "description": "Panels in the Widget library: a script that prints text or JSON, or a web page.",
      "items": {
        "$ref": "#/$defs/Panel"
      },
      "type": "array"
    },
    "setting": {
      "description": "Values the user sets on the Plugins page; every run gets them as `settings`.",
      "items": {
        "$ref": "#/$defs/Setting"
      },
      "type": "array"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "version"
  ],
  "title": "Nunchiro plugin.toml",
  "type": "object"
}
